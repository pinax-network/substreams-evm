{
  "arithmetic": {
    "balance": "Checked raw + hourly then + daily. No expected RPC balance/helper output enters the model.",
    "cap": "If field12>0: checked currentHour-last39>168 =>0; else checked field12*5 then amount40*100; provided<required=>0. cap=field3*3; cap<=claimed10=>0. Remaining=cap-claimed10. price=two-hop amountOut(1e18). existing=floor(field12*price/1e18); existing>=remaining=>0. If existing+floor(reward*price/1e18)>remaining, result=floor((remaining-existing)*1e18/price), else reward.",
    "daily": "Start lastDay, stop at currentDay or after three periods with all total/user/reward positive. A positive-input contribution whose quotient floors to zero still counts. Initial zero user and reward=0 with total>0 remain unsupported.",
    "hourly": "Start lastHour, exclusive stop=min(currentHour,lastHour+168). Nonzero total/user updates carry; initial zero user falls back to holder field5. Each contribution floor(reward*user/total).",
    "reserve_direction": "Pool A reserve1 token input to reserve0 WBNB; pool B reserve1 WBNB input to reserve0 USDT. Both floor at each hop.",
    "router": "amountWithFee=amountIn*9975; numerator=amountWithFee*reserveOut; denominator=reserveIn*10000+amountWithFee; floor(numerator/denominator)"
  },
