{
  "arithmetic": {
    "call_sites": "Preview iff stored reward0 and carriedtotal>0, before testing user>0. Preview updates simulated pool; nonzero stored rewards and total0 skips leave it unchanged. Hourly/daily top-level helpers each begin from original poolbalance independently.",
    "daily": "At most24 iterations; stop for pool0 or burn0. Each iteration computes same current-day rate, burn=floor(pool*rate/100000), adds floor(burn*15000/100000), then remaining=pool-burn (or0 ifburn>pool).",
    "hourly": "pool0=>reward0,pool0. burn=floor(pool*rate/100000). burn0=>reward0,pool unchanged. reward=floor(burn*30000/100000); remaining=checked(pool-burn).",
    "initial_daily_zero": "Initial user rate0 falls back to holder field6 iff holder field8>0; otherwise carries0 until a nonzero period user rate arrives.",
    "preview_rate": "currentDay=floor((timestamp-epoch29)/86400); rate=floor(min(1200+240*floor(currentDay/10),3600)/24). Checked multiplication/addition precede clamp.",
    "rate_overflow_bound": "For uint256 timestamp and valid epoch subtraction, currentDay<=MAX/86400, so floor(currentDay/10)*240+1200 cannot overflow. Pool*rate overflow is representable and tested."
  },
